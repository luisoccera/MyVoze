<Application x:Class="VoxMorph.Controlador.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanoAVisibilidad" />
        <SolidColorBrush x:Key="FondoAplicacion" Color="#0B0D14" />
        <SolidColorBrush x:Key="FondoPanel" Color="#151925" />
        <SolidColorBrush x:Key="FondoControl" Color="#202638" />
        <SolidColorBrush x:Key="ColorVioleta" Color="#8B5CF6" />
        <SolidColorBrush x:Key="ColorCian" Color="#22D3EE" />
        <SolidColorBrush x:Key="TextoPrincipal" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextoSecundario" Color="#CBD5E1" />
        <SolidColorBrush x:Key="ColorError" Color="#FB7185" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource FondoAplicacion}" />
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FondoControl}" />
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="BorderBrush" Value="#3A4259" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="BotonPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorVioleta}" />
            <Setter Property="BorderBrush" Value="{StaticResource ColorVioleta}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="20,12" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource FondoControl}" />
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#6D28D9" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#7C3AED" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="Background" Value="{StaticResource FondoControl}" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="Foreground" Value="#111827" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="Background" Value="{StaticResource FondoControl}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FondoControl}" />
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="BorderBrush" Value="#3A4259" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="CaretBrush" Value="{StaticResource ColorCian}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource ColorCian}" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource ColorCian}" />
            <Setter Property="Background" Value="#252B3B" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
